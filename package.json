{
  "private": true,
  "name": "screen-flower",
  "description": "screen util such as flower",
  "version": "0.4.2",
  "author": "YanQue",
  "main": "app/background.js",
  "scripts": {
    "dev": "NODE_ENV=development nextron",
    "dev:only_next": "NODE_ENV=development NODE_ENV_BROWSER=yes next -p 8888 src/renderer",
    "dev:windows:electron": "electron . 8888 --remote-debugging-port=5858 --inspect=9292",
    "dev:windows:next": "next -p 8888 src/renderer",
    "build": "export CSC_IDENTITY_AUTO_DISCOVERY=false && nextron build",
    "build:prod": "nextron build --config electron-builder.prod.yml",
    "build:mac": "export CSC_IDENTITY_AUTO_DISCOVERY=false && nextron build --mac --x64",
    "build:mac:universal": "nextron build --mac --universal",
    "build:win": "nextron build --win --ia32",
    "build:linux": "nextron build --linux",
    "postinstall": "electron-builder install-app-deps",
    "build:next": "next build src/renderer",
    "setVersion": "updatePackageVersion .",
    "prepare": "husky"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@radix-ui/react-toolbar": "^1.1.0",
    "@radix-ui/themes": "^3.1.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@yanquer/common": "^0.8.0",
    "@yanquer/node-bin": "^0.8.0",
    "@yanquer/browser": "^0.8.0",
    "electron-log": "^5.1.6",
    "electron-serve": "^1.3.0",
    "electron-store": "^8.2.0",
    "execa": "^9.3.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-mac-permissions": "^2.4.0",
    "plyr": "^3.7.8",
    "plyr-react": "^5.3.0",
    "postcss": "^8.5.4",
    "react-draggable": "^4.4.6",
    "react-rnd": "^10.4.11",
    "react-svg": "^16.1.34",
    "tailwindcss": "^4.1.8"
  },
  "devDependencies": {
    "@babel/core": "^7.24.9",
    "@babel/helper-hoist-variables": "^7.24.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.24.7",
    "@babel/preset-env": "^7.24.8",
    "@babel/preset-typescript": "^7.24.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.6",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.11",
    "@types/react": "19.1.6",
    "@yanquer/nextron": "9.5.0-d5",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3",
    "electron-builder-squirrel-windows": "^24.13.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "mocha": "^10.7.0",
    "next": "15.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resolve-package-path": "^4.0.3",
    "sass": "^1.77.7",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.98.0"
  },
  "overrides": {
    "@types/react": "19.1.6"
  }
}